# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=carebridge_hospital
DB_USER=postgres
DB_PASS=your_password_here

# JWT Secrets (use strong random strings in production)
JWT_ACCESS_SECRET=carebridge_access_secret_change_in_production_abc123xyz789
JWT_REFRESH_SECRET=carebridge_refresh_secret_change_in_production_def456uvw321
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000

# Email verification & password reset (Brevo transactional email)
# Create an API key at https://app.brevo.com/settings/keys/api
# The sender email must be verified in Brevo (Senders & IP > Senders).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@yourdomain.com
BREVO_SENDER_NAME=CareBridge Specialist Hospital
BREVO_REPLY_TO=support@yourdomain.com

# One-time password settings
OTP_SECRET=change_this_to_a_random_secret
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Logging
LOG_LEVEL=debug
