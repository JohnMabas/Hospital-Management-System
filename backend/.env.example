# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=carebridge_hospital
DB_USER=postgres
DB_PASS=your_password_here

# JWT Secrets (use strong random strings in production)
JWT_ACCESS_SECRET=carebridge_access_secret_change_in_production_abc123xyz789
JWT_REFRESH_SECRET=carebridge_refresh_secret_change_in_production_def456uvw321
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000

# Email (optional - for password reset emails in production)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password

# Logging
LOG_LEVEL=debug
